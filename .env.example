NODE_ENV=development
MAINTENANCE_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BOOKING_COOKIE_SECRET=<long random string>

# Admin authentication. Use long random values in production.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_MFA_ENCRYPTION_KEY=

# Owner account created by `pnpm db:owner`.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_FIRST_NAME=
OWNER_LAST_NAME=

# Database (PostgreSQL). These defaults match docker-compose.yml.
POSTGRES_DB=divine_apartments
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/divine_apartments

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Online payments. Set PAYMENT_PROVIDER to a registered adapter. Leave the provider key blank to keep bank transfer only.
PAYMENT_PROVIDER=paystack
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_BASE_URL=https://api.paystack.co

# Transfer receipts. STORAGE_PROVIDER=s3 works with AWS S3 and S3-compatible services.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
