NODE_ENV=development
MAINTENANCE_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SITE_NAME=Quill Apartments
BOOKING_COOKIE_SECRET=<long random string>

# Admin authentication.
JWT_ACCESS_SECRET=<long random string>
JWT_REFRESH_SECRET=<long random string>
ADMIN_MFA_ENCRYPTION_KEY=<long random string>
ADMIN_CSRF_SECRET=<long random string>

# Owner account created by `pnpm seed:bootstrap`
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_FIRST_NAME=
OWNER_LAST_NAME=

# Seed safety. Demo data is refused unless the database host is listed here or
# the command is run with --i-understand-this-is-demo-data.
DEMO_DB_HOST_ALLOWLIST=localhost,127.0.0.1
NOTIFICATION_RECIPIENT_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_RECEPTION_PASSWORD=
SEED_NOW=
SEED_RANDOM_SEED=quill-demo-2026

# Seed tests and Playwright. Run `pnpm seed:e2e` before `pnpm test:e2e`.
SEED_TEST_DATABASE_URL=
E2E_TEMPLATE_DATABASE_URL=
E2E_BASE_URL=http://localhost:3002

# Database 
POSTGRES_DB=quill_apartments
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quill_apartments

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Online payments. Set PAYMENT_PROVIDER to a registered adapter. Leave the provider key blank to keep bank transfer only.
PAYMENT_PROVIDER=paystack
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_BASE_URL=https://api.paystack.co

# Lifecycle cron endpoint protection
CRON_SECRET=
NOTIFICATION_WEBHOOK_URL=

# works with AWS S3 and S3-compatible services.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
